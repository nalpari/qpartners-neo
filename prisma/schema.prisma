generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// 권한 정의
/// 화면 근거: 권한관리 (p.49)
model QpRole {
  id                Int                    @id @default(autoincrement())
  roleCode          String                 @unique @map("role_code") @db.VarChar(50)
  roleName          String                 @map("role_name") @db.VarChar(100)
  description       String?                @db.VarChar(500)
  isActive          Boolean                @default(true) @map("is_active")
  isSystem          Boolean                @default(false) @map("is_system")
  createdAt         DateTime               @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy         String?                @map("created_by") @db.VarChar(255)
  updatedAt         DateTime               @updatedAt @map("updated_at")
  updatedBy         String?                @map("updated_by") @db.VarChar(255)
  permissions       QpRoleMenuPermission[]
  contentTargets    ContentTarget[]
  homeNoticeTargets HomeNoticeTarget[]
  massMailTargets   MassMailTarget[]

  @@map("qp_roles")
}

/// 역할별 메뉴 CRUD 권한
/// 화면 근거: 권한관리 > Available Menu Setting (p.50)
/// PK: [roleCode, menuCode] 복합키 — 동일 권한+메뉴 조합은 하나만 존재
model QpRoleMenuPermission {
  roleCode  String   @map("role_code") @db.VarChar(50)
  menuCode  String   @map("menu_code") @db.VarChar(50)
  canRead   Boolean  @default(false) @map("can_read")
  canCreate Boolean  @default(false) @map("can_create")
  canUpdate Boolean  @default(false) @map("can_update")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(255)
  menu      Menu     @relation(fields: [menuCode], references: [menuCode])
  role      QpRole   @relation(fields: [roleCode], references: [roleCode])

  @@id([roleCode, menuCode])
  @@index([menuCode], map: "qp_role_menu_permissions_menu_code_fkey")
  @@map("qp_role_menu_permissions")
}

/// 메뉴관리
/// 화면 근거: 관리자 > 메뉴관리 (p.51)
model Menu {
  id           Int                    @id @default(autoincrement())
  parentId     Int?                   @map("parent_id")
  menuCode     String                 @unique @map("menu_code") @db.VarChar(50)
  menuName     String                 @map("menu_name") @db.VarChar(100)
  pageUrl      String?                @map("page_url") @db.VarChar(500)
  isActive     Boolean                @default(true) @map("is_active")
  showInTopNav Boolean                @default(true) @map("show_in_top_nav")
  showInMobile Boolean                @default(true) @map("show_in_mobile")
  sortOrder    Int                    @default(1) @map("sort_order")
  createdAt    DateTime               @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy    String?                @map("created_by") @db.VarChar(255)
  updatedAt    DateTime               @updatedAt @map("updated_at")
  updatedBy    String?                @map("updated_by") @db.VarChar(255)
  parent       Menu?                  @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Menu[]                 @relation("MenuTree")
  permissions  QpRoleMenuPermission[]

  @@index([parentId], map: "idx_parent_id")
  @@index([isActive, sortOrder], map: "idx_active_sort")
  @@map("qp_menus")
}

/// 공통코드 헤더
/// 화면 근거: 관리자 > 코드 관리 (p.52)
model CodeHeader {
  id          Int          @id @default(autoincrement())
  headerCode  String       @unique @map("header_code") @db.VarChar(20)
  headerAlias String       @map("header_alias") @db.VarChar(50)
  headerName  String       @map("header_name") @db.VarChar(255)
  relCode1    String?      @map("rel_code1") @db.VarChar(100)
  relCode2    String?      @map("rel_code2") @db.VarChar(100)
  relCode3    String?      @map("rel_code3") @db.VarChar(100)
  relNum1     Decimal?     @map("rel_num1") @db.Decimal(15, 2)
  relNum2     Decimal?     @map("rel_num2") @db.Decimal(15, 2)
  relNum3     Decimal?     @map("rel_num3") @db.Decimal(15, 2)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy   String?      @map("created_by") @db.VarChar(255)
  updatedAt   DateTime     @updatedAt @map("updated_at")
  updatedBy   String?      @map("updated_by") @db.VarChar(255)
  details     CodeDetail[]

  @@map("qp_code_headers")
}

/// 공통코드 상세
/// 화면 근거: 관리자 > 코드 관리 > Detail (p.52)
model CodeDetail {
  id          Int        @id @default(autoincrement())
  headerId    Int        @map("header_id")
  code        String     @db.VarChar(20)
  displayCode String     @map("display_code") @db.VarChar(20)
  codeName    String     @map("code_name") @db.VarChar(255)
  codeNameEtc String?    @map("code_name_etc") @db.VarChar(255)
  relCode1    String?    @map("rel_code1") @db.VarChar(100)
  relCode2    String?    @map("rel_code2") @db.VarChar(100)
  relCode3    String?    @map("rel_code3") @db.VarChar(100)
  relNum1     Decimal?   @map("rel_num1") @db.Decimal(15, 2)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy   String?    @map("created_by") @db.VarChar(255)
  updatedAt   DateTime   @updatedAt @map("updated_at")
  updatedBy   String?    @map("updated_by") @db.VarChar(255)
  header      CodeHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)

  @@unique([headerId, code], map: "idx_header_code")
  @@index([headerId], map: "idx_header_id")
  @@map("qp_code_details")
}

/// 콘텐츠
/// 화면 근거: 목록 (p.22-24), 등록 (p.25-27), 조회 (p.28-29), 수정 (p.30-31)
model Content {
  id               Int                   @id @default(autoincrement())
  userType         qp_contents_user_type @map("user_type")
  userId           String                @map("user_id") @db.VarChar(255)
  authorDepartment String?               @map("author_department") @db.VarChar(100)
  approverLevel    Int?                  @map("approver_level") @db.TinyInt
  title            String                @db.VarChar(500)
  body             String?               @db.MediumText
  status           ContentStatus         @default(draft)
  publishedAt      DateTime?             @map("published_at")
  viewCount        Int                   @default(0) @map("view_count")
  createdAt        DateTime              @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy        String?               @map("created_by") @db.VarChar(255)
  updatedAt        DateTime              @updatedAt @map("updated_at")
  updatedBy        String?               @map("updated_by") @db.VarChar(255)
  attachments      ContentAttachment[]
  categories       ContentCategory[]
  productModels    ContentProductModel[]
  inlineImages     ContentInlineImage[]
  targets          ContentTarget[]
  downloadLogs     DownloadLog[]

  @@index([status], map: "idx_status")
  @@index([publishedAt], map: "idx_published_at")
  @@index([createdAt], map: "idx_created_at")
  @@index([userType, userId], map: "idx_user")
  @@index([status, publishedAt], map: "idx_status_published")
  @@index([authorDepartment], map: "idx_author_department")
  @@map("qp_contents")
}

/// 콘텐츠 게시대상
/// 화면 근거: 콘텐츠 등록 > 게시대상 체크박스 + 기간설정 (p.25 #7, #8)
/// UK: [contentId, targetType] — 동일 콘텐츠에 같은 게시대상 중복 불가
model ContentTarget {
  id        Int       @id @default(autoincrement())
  contentId Int       @map("content_id")
  /// null = 비회원 게시대상 (qp_roles 외부 sentinel — useTargetLabels.ts 코드 의도)
  roleCode  String?   @map("role_code") @db.VarChar(50)
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  createdAt DateTime  @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy String?   @map("created_by") @db.VarChar(255)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.VarChar(255)
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  role      QpRole?   @relation(fields: [roleCode], references: [roleCode], onDelete: Restrict)

  @@unique([contentId, roleCode], map: "idx_content_target")
  @@index([roleCode, startAt, endAt], map: "idx_target_period")
  @@map("qp_content_targets")
}

/// 카테고리
/// 화면 근거: 카테고리 관리 (p.48)
model Category {
  id             Int               @id @default(autoincrement())
  parentId       Int?              @map("parent_id")
  categoryCode   String            @unique @map("category_code") @db.VarChar(50)
  name           String            @db.VarChar(100)
  isInternalOnly Boolean           @default(false) @map("is_internal_only")
  sortOrder      Int               @default(1) @map("sort_order")
  isActive       Boolean           @default(true) @map("is_active")
  isVisible      Boolean           @default(true) @map("is_visible")
  /**
   * 제품일람(製品一覧) 노출 대상 여부 — REQ-008.
   * 켜면 검색화면 제품일람 탭의 「型番」 축과 형번관리의 카테고리 선택지에 나타난다.
   * 2026-10-08 현업 리뷰로 제품 카테고리 한정 → **전 카테고리** 적용으로 확장됐다(고객 확장성 요구).
   * 실제 사용은 2Depth 한정 — 1Depth 에는 형번을 붙이지 않는다.
   * `isVisible`(리스트 표시, 1Depth 전용)·`isActive`(사용 여부) 와는 독립된 축이다.
   */
  isProductList  Boolean           @default(false) @map("is_product_list")
  createdAt      DateTime          @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy      String?           @map("created_by") @db.VarChar(255)
  updatedAt      DateTime          @updatedAt @map("updated_at")
  updatedBy      String?           @map("updated_by") @db.VarChar(255)
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Category[]        @relation("CategoryTree")
  contents       ContentCategory[]
  productModels  ProductModel[]

  @@index([parentId], map: "idx_parent_id")
  @@index([isActive, sortOrder], map: "idx_active_sort")
  @@map("qp_categories")
}

/// 콘텐츠-카테고리 연결 (N:M)
/// PK: [contentId, categoryId] 복합키
/// 인덱스 정책:
///   - PK [contentId, categoryId] → 콘텐츠 기준 조회 + 유일성 보장
///   - [categoryId, contentId] → 카테고리 멀티 검색 시 distinct contentId 추출용 커버링 인덱스
///     (`/api/contents` GET 의 categoryIds 필터에서 Index-Only Scan 가능)
model ContentCategory {
  contentId  Int      @map("content_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy  String?  @map("created_by") @db.VarChar(255)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@index([categoryId, contentId], map: "qp_content_categories_category_content_idx")
  @@map("qp_content_categories")
}

/**
 * 형번(型番) 마스터 — REQ-007.
 *
 * 형번을 카테고리로 관리하지 않는 이유:
 *   - `/api/categories/route.ts` 가 3Depth 를 거부한다 (제품 카테고리 하위에 형번을 넣을 수 없음)
 *   - `isVisible` 이 1Depth 전용이라 REQ-007 의 형번별 표시/비표시를 표현할 수 없음
 *   - 카테고리끼리 연결하는 구조가 없어 제품 상태를 형번에 붙일 수 없음
 * 따라서 별도 마스터로 분리하고, 카테고리에는 노출 플래그(`Category.isProductList`) 하나만 둔다.
 *
 * 기존 데이터 이행은 없다 — 운영 배포 시점부터 신규 등록·관리한다.
 */
model ProductModel {
  id         Int                   @id @default(autoincrement())
  categoryId Int                   @map("category_id")
  /**
   * 형번명. 동일 카테고리 내에서만 중복을 막는다 (다른 카테고리에는 같은 형번 등록 가능).
   * 비교 규칙은 `@@unique` + 컬럼 콜레이션 `utf8mb4_unicode_ci` 가 담당한다:
   *   - 대소문자 무시  (`_ci`)          — `HQJP-A44` == `hqjp-a44`
   *   - 뒤 공백 무시  (PAD SPACE)       — `HQJP-A44 ` == `HQJP-A44`
   * 앞 공백은 콜레이션이 처리하지 않으므로 **저장 전 애플리케이션에서 trim 한다**.
   * 가운데 공백은 보존한다 — `栄信 SRシリーズ` 처럼 의미를 갖는 형번이 있어, 제거하면
   * 서로 다른 형번이 중복으로 막힌다.
   */
  modelCode  String                @map("model_code") @db.VarChar(100)
  /**
   * 제품상태 — 요구사항정의서 v1.1 REQ-007 의 형번 마스터 관리 항목.
   *
   * 자료(콘텐츠)는 제품상태를 직접 갖지 않는다. 자료일람에 표시되는 제품상태는
   * **연결된 형번에서 파생**한다 (REQ-005): 하나라도 `current` 면 현행품,
   * 전부 `eol` 이면 단종품, 연결된 형번이 없으면 「-」.
   *
   * 값은 목업 `03-admin-models.html` 의 `modelStatus` 라디오와 같다 (`current` / `eol`).
   * 기존 행은 `current` 로 채운다 — 단종 처리는 운영자가 형번관리에서 개별 지정한다.
   */
  status     ProductModelStatus    @default(current)

  /** 표시 우선순위. 중복 허용 — 같은 값이면 형번명 昇順으로 정렬한다 (2026-10-08 리뷰 결정) */
  sortOrder  Int                   @default(1) @map("sort_order")
  /** 이용자 화면 노출 여부. false 여도 관리자 콘텐츠 등록 화면에서는 선택할 수 있다 (REQ-007 방침2) */
  isVisible  Boolean               @default(true) @map("is_visible")
  createdAt  DateTime              @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy  String?               @map("created_by") @db.VarChar(255)
  updatedAt  DateTime              @updatedAt @map("updated_at")
  updatedBy  String?               @map("updated_by") @db.VarChar(255)
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contents   ContentProductModel[]

  @@unique([categoryId, modelCode], map: "qp_product_models_category_model_key")
  @@index([categoryId, sortOrder], map: "idx_category_sort")
  @@index([isVisible], map: "idx_visible")
  @@map("qp_product_models")
}

/**
 * 자료 ↔ 형번 N:M — REQ-009. 자료 1건에 형번을 복수 연결한다.
 *
 * 형번을 삭제하면 이 연결 행만 함께 사라지고 자료 자체는 남는다 (onDelete: Cascade).
 * 연결을 남겨두면 존재하지 않는 형번이 자료 상세와 검색 필터에 유령으로 나타난다.
 */
model ContentProductModel {
  contentId      Int          @map("content_id")
  productModelId Int          @map("product_model_id")
  createdAt      DateTime     @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy      String?      @map("created_by") @db.VarChar(255)
  content        Content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  productModel   ProductModel @relation(fields: [productModelId], references: [id], onDelete: Cascade)

  @@id([contentId, productModelId])
  @@index([productModelId, contentId], map: "qp_content_product_models_model_content_idx")
  @@map("qp_content_product_models")
}

/// 콘텐츠 첨부파일
/// 화면 근거: 등록 > 파일첨부 (p.27 #13), 상세 (p.29 #11, #12)
model ContentAttachment {
  id           Int           @id @default(autoincrement())
  contentId    Int           @map("content_id")
  fileName     String        @map("file_name") @db.VarChar(255)
  filePath     String        @map("file_path") @db.VarChar(500)
  fileSize     BigInt?       @map("file_size")
  mimeType     String?       @map("mime_type") @db.VarChar(100)
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy    String?       @map("created_by") @db.VarChar(255)
  updatedAt    DateTime      @updatedAt @map("updated_at")
  updatedBy    String?       @map("updated_by") @db.VarChar(255)
  content      Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  downloadLogs DownloadLog[]

  @@index([contentId], map: "idx_content_id")
  @@map("qp_content_attachments")
}

/// 본문 임베드 이미지 (BlockNote 에디터 업로드)
/// 첨부파일과 라이프사이클이 다름:
///   - 폼 저장 전 contentId=null 상태로 디스크/DB에 선존재
///   - 폼 저장 시 본문 HTML에 사용된 ID만 contentId로 stamp, 나머지 즉시 삭제
model ContentInlineImage {
  id          Int                                 @id @default(autoincrement())
  contentId   Int?                                @map("content_id")
  ownerType   qp_content_inline_images_owner_type @map("owner_type")
  ownerUserId String                              @map("owner_user_id") @db.VarChar(255)
  fileName    String                              @map("file_name") @db.VarChar(255)
  filePath    String                              @map("file_path") @db.VarChar(500)
  fileSize    BigInt                              @map("file_size")
  mimeType    String                              @map("mime_type") @db.VarChar(100)
  createdAt   DateTime                            @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  content     Content?                            @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId], map: "idx_content_id")
  @@index([ownerType, ownerUserId, contentId], map: "idx_owner")
  @@map("qp_content_inline_images")
}

/// 비밀번호 재설정 토큰
/// 화면 근거: 비밀번호 초기화 팝업 (p.11), 변경 링크 메일 (p.12)
model PasswordResetToken {
  id        Int                                @id @default(autoincrement())
  userType  qp_password_reset_tokens_user_type @map("user_type")
  userId    String                             @map("user_id") @db.VarChar(255)
  loginId   String?                            @map("login_id") @db.VarChar(255)
  token     String                             @unique @db.VarChar(255)
  expiresAt DateTime                           @map("expires_at")
  used      Boolean                            @default(false)
  createdAt DateTime                           @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy String?                            @map("created_by") @db.VarChar(255)

  @@index([userType, userId], map: "idx_user")
  @@index([expiresAt], map: "idx_expires_at")
  @@map("qp_password_reset_tokens")
}

/// 2차 인증 코드
/// 화면 근거: 2차인증 팝업 (p.14), 2단계 인증 알림메일 (p.15)
model TwoFactorCode {
  id         Int                           @id @default(autoincrement())
  userType   qp_two_factor_codes_user_type @map("user_type")
  userId     String                        @map("user_id") @db.VarChar(255)
  code       String                        @db.VarChar(64)
  expiresAt  DateTime                      @map("expires_at")
  verified   Boolean                       @default(false)
  createdAt  DateTime                      @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy  String?                       @map("created_by") @db.VarChar(255)
  verifiedAt DateTime?                     @map("verified_at")
  attempts   Int                           @default(0)

  @@index([userType, userId], map: "idx_user")
  @@index([expiresAt], map: "idx_expires_at")
  @@map("qp_two_factor_codes")
}

/// 홈화면 공지
/// 화면 근거: 홈화면 공지관리 (p.46-47)
model HomeNotice {
  id        Int                       @id @default(autoincrement())
  userType  qp_home_notices_user_type @map("user_type")
  userId    String                    @map("user_id") @db.VarChar(255)
  startAt   DateTime                  @map("start_at")
  endAt     DateTime                  @map("end_at")
  title     String                    @default("無題") @db.VarChar(100)
  content   String                    @db.Text
  url       String?                   @db.VarChar(500)
  createdAt DateTime                  @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy String?                   @map("created_by") @db.VarChar(255)
  updatedAt DateTime                  @updatedAt @map("updated_at")
  updatedBy String?                   @map("updated_by") @db.VarChar(255)
  targets   HomeNoticeTarget[]

  @@index([startAt, endAt], map: "idx_period")
  @@map("qp_home_notices")
}

/// 홈공지 게시대상 (정규화) — qp_roles FK 기반 동적 권한 그룹
/// 화면 근거: 홈화면 공지관리 게시대상 체크박스 (p.46-47)
model HomeNoticeTarget {
  id           Int        @id @default(autoincrement())
  homeNoticeId Int        @map("home_notice_id")
  roleCode     String     @map("role_code") @db.VarChar(50)
  homeNotice   HomeNotice @relation(fields: [homeNoticeId], references: [id], onDelete: Cascade)
  role         QpRole     @relation(fields: [roleCode], references: [roleCode], onDelete: Restrict)

  @@unique([homeNoticeId, roleCode], map: "uq_notice_role")
  @@index([roleCode], map: "idx_notice_role")
  @@map("qp_home_notice_targets")
}

/// 대량메일 발송
/// 화면 근거: 대량메일발송 (p.43-45)
model MassMail {
  id              Int                     @id @default(autoincrement())
  userType        qp_mass_mails_user_type @map("user_type")
  userId          String                  @map("user_id") @db.VarChar(255)
  senderName      String                  @map("sender_name") @db.VarChar(255)
  subject         String                  @db.VarChar(500)
  body            String                  @db.MediumText
  status          MailStatus              @default(draft)
  /// 예약발송 지정 일시. 즉시발송은 null, 예약발송은 미래 시각, draft 는 null 가능.
  /// scheduled 상태의 건은 이 시각이 도래하면 auto-retry-batch 가 pending 으로 전이 후 발송.
  scheduledSendAt DateTime?               @map("scheduled_send_at")
  sentAt          DateTime?               @map("sent_at")
  sentTotal       Int                     @default(0) @map("sent_total")
  sentSuccess     Int                     @default(0) @map("sent_success")
  sentFailed      Int                     @default(0) @map("sent_failed")
  createdAt       DateTime                @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy       String?                 @map("created_by") @db.VarChar(255)
  createdByName   String?                 @map("created_by_name") @db.VarChar(255)
  updatedAt       DateTime                @updatedAt @map("updated_at")
  updatedBy       String?                 @map("updated_by") @db.VarChar(255)
  optOut          Boolean                 @default(false) @map("opt_out")
  targets         MassMailTarget[]
  attachments     MassMailAttachment[]
  recipients      MassMailRecipient[]

  @@index([status], map: "idx_status")
  @@index([sentAt], map: "idx_sent_at")
  @@index([status, createdAt(sort: Desc)], map: "idx_status_created_at")
  /// 좀비 감지 핫 패스 — auto-retry-batch 가 3분마다 sending+updatedAt<cutoff 스캔.
  /// 단일 status 인덱스만으론 sending 전체 read 후 메모리 필터 → 적체 시 비용 폭주.
  @@index([status, updatedAt], map: "idx_status_updated_at")
  /// 예약발송 도래 스캔 핫 패스 — auto-retry-batch 가 3분마다 scheduled+scheduledSendAt<=now 스캔.
  @@index([status, scheduledSendAt], map: "idx_status_scheduled_send_at")
  @@map("qp_mass_mails")
}

/// 대량메일 수신대상 (정규화) — qp_roles FK 기반 동적 권한 그룹
/// 화면 근거: 대량메일발송 수신대상 체크박스 (p.43-45)
model MassMailTarget {
  id         Int      @id @default(autoincrement())
  massMailId Int      @map("mass_mail_id")
  roleCode   String   @map("role_code") @db.VarChar(50)
  massMail   MassMail @relation(fields: [massMailId], references: [id], onDelete: Cascade)
  role       QpRole   @relation(fields: [roleCode], references: [roleCode], onDelete: Restrict)

  @@unique([massMailId, roleCode], map: "uq_mail_role")
  @@index([roleCode], map: "idx_mail_role")
  @@map("qp_mass_mail_targets")
}

/// 대량메일 첨부파일
model MassMailAttachment {
  id         Int      @id @default(autoincrement())
  massMailId Int      @map("mass_mail_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  filePath   String   @map("file_path") @db.VarChar(500)
  fileSize   BigInt?  @map("file_size")
  createdAt  DateTime @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy  String?  @map("created_by") @db.VarChar(255)
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.VarChar(255)
  massMail   MassMail @relation(fields: [massMailId], references: [id], onDelete: Cascade)

  @@index([massMailId], map: "idx_mass_mail_id")
  @@map("qp_mass_mail_attachments")
}

/// 대량메일 수신자 (발송 대상 개별 추적)
/// Plan/Design: mass-mail-send (비동기 발송 + 장애 복구)
model MassMailRecipient {
  id           Int             @id @default(autoincrement())
  massMailId   Int             @map("mass_mail_id")
  email        String          @db.VarChar(255)
  userName     String?         @map("user_name") @db.VarChar(255)
  /// 발송 시점 권한 코드 snapshot — FK 없음 (발송 후 권한 변경/비활성화 무관하게 발송 이력 보존)
  authRoleCode String          @map("auth_role_code") @db.VarChar(50)
  status       RecipientStatus @default(pending)
  sentAt       DateTime?       @map("sent_at")
  errorMessage String?         @map("error_message") @db.VarChar(500)
  createdAt    DateTime        @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("created_at")
  createdBy    String?         @map("created_by") @db.VarChar(255)
  /// SMTP 시도 누적 횟수. 상한 recipientMaxRetry 도달 시 status='failed' 로 영구 마킹.
  retryCount   Int             @default(0) @map("retry_count")
  massMail     MassMail        @relation(fields: [massMailId], references: [id], onDelete: Cascade)

  @@unique([massMailId, email], map: "uq_mass_mail_email")
  @@index([massMailId, status], map: "idx_mass_mail_status")
  /// sendLoop / batch cycle 의 pending+retryCount<max 핫 쿼리용 — retryCount 까지 인덱스화.
  @@index([massMailId, status, retryCount], map: "idx_mm_status_retry")
  @@map("qp_mass_mail_recipients")
}

/// 다운로드 기록
/// 화면 근거: 마이페이지 > 다운로드 기록 (p.37)
model DownloadLog {
  id           Int                        @id @default(autoincrement())
  userType     qp_download_logs_user_type @map("user_type")
  userId       String                     @map("user_id") @db.VarChar(255)
  contentId    Int                        @map("content_id")
  attachmentId Int?                       @map("attachment_id")
  downloadedAt DateTime                   @default(dbgenerated("UTC_TIMESTAMP(3)")) @map("downloaded_at")
  attachment   ContentAttachment?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  // TODO(montreal-review MF-W): contentId FK에 onDelete 미지정 → 기본 RESTRICT.
  //   Content 삭제 시 download log가 있으면 FK violation 500 발생 가능.
  //   설계 결정 필요:
  //   (a) Cascade: 다운로드 이력 함께 삭제 (audit 손실, attachmentId의 SetNull 의도와 비대칭)
  //   (b) SetNull: 이력 보존 (contentId 컬럼 nullable로 변경 필요 — 마이그레이션 영향 큼)
  //   현재는 Content 삭제 자체가 soft-delete(`status: deleted`)로 구현되어 있어
  //   실 FK violation 발생 가능성은 낮으나, hard delete 도입 시 즉시 반영 필요.
  content      Content                    @relation(fields: [contentId], references: [id])

  @@index([userType, userId], map: "idx_user")
  @@index([downloadedAt], map: "idx_downloaded_at")
  @@index([attachmentId], map: "qp_download_logs_attachment_id_fkey")
  @@index([contentId], map: "qp_download_logs_content_id_fkey")
  @@map("qp_download_logs")
}

